/* 简约白色背景，圆角设计样式表 */
 QMainWindow, QDialog, QWidget {
     background-color: white;
     border-radius: 8px;
 }

 /* 主窗口 */
 QMainWindow {
     background-color: white;
 }

 /* 对话框 */
 QDialog {
     background-color: white;
     border-radius: 10px;
 }

 /* 按钮样式 */
 QPushButton {
     background-color: #f0f0f0;
     border: 1px solid #d0d0d0;
     border-radius: 6px;
     padding: 6px 12px;
     color: #333333;
 }

 QPushButton:hover {
     background-color: #e0e0e0;
 }

 QPushButton:pressed {
     background-color: #d0d0d0;
 }

 QPushButton#addButton {
     background-color: #4CAF50;
     color: white;
 }

 QPushButton#addButton:hover {
     background-color: #45a049;
 }

 QPushButton#removeButton {
     background-color: #f44336;
     color: white;
 }

 QPushButton#removeButton:hover {
     background-color: #da190b;
 }

 QPushButton#okButton, QPushButton#saveButton {
     background-color: #2196F3;
     color: white;
 }

 QPushButton#okButton:hover, QPushButton#saveButton:hover {
     background-color: #0b7dda;
 }

 /* 输入框样式 */
 QLineEdit, QSpinBox {
     border: 1px solid #d0d0d0;
     border-radius: 6px;
     padding: 4px;
 }

 QLineEdit:focus, QSpinBox:focus {
     border: 1px solid #2196F3;
 }

 /* 表格样式 */


 /* 列表控件样式 */
 QListWidget {
     border: 1px solid #d0d0d0;
     border-radius: 6px;
 }

 /* 分组框样式 */
 QGroupBox {
     border: 1px solid #d0d0d0;
     border-radius: 8px;
     margin-top: 1ex;
 }

 QGroupBox::title {
     subcontrol-origin: margin;
     subcontrol-position: top center;
     padding: 0 5px;
     background-color: white;
 }

 /* 标签样式 */
 QLabel {
     color: #333333;
 }

 /* 复选框样式 */
 QCheckBox {
     spacing: 5px;
 }

 QCheckBox::indicator {
     width: 18px;
     height: 18px;
 }

 QCheckBox::indicator:unchecked {
     border: 1px solid #d0d0d0;
     border-radius: 4px;
 }

 QCheckBox::indicator:checked {
     border: 1px solid #2196F3;
     border-radius: 4px;
     background-color: #2196F3;
 }

 /* 状态栏样式 */
 QStatusBar {
     background-color: #f5f5f5;
     border-top: 1px solid #d0d0d0;
 }

 /* 菜单栏样式 */
 QMenuBar {
     background-color: white;
     border-bottom: 1px solid #d0d0d0;
 }

 QMenuBar::item {
     background: transparent;
     padding: 4px 8px;
 }

 QMenuBar::item:selected {
     background: #e0e0e0;
 }

 QMenuBar::item:pressed {
     background: #d0d0d0;
 }

 QMenu {
     background-color: white;
     border: 1px solid #d0d0d0;
     border-radius: 4px;
 }

 QMenu::item {
     padding: 4px 20px;
 }

 QMenu::item:selected {
     background-color: #e0e0e0;
 }

 /* 系统托盘菜单样式 */
 QSystemTrayIcon QMenu {
     color: black;
     background-color: #f0f0f0;
 }

 QSystemTrayIcon QMenu::item {
     color: black;
     background-color: #f0f0f0;
 }

 QSystemTrayIcon QMenu::item:selected {
     background-color: #d0d0d0;
 }